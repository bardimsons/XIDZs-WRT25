# Put your custom commands here that should be executed once
# x-gpio only for hg680-p & b860h
#sleep 7 && /usr/bin/x-gpio -r
#sleep 7 && /sbin/free.sh
#/sbin/jam bug.com
# Pin eth0 (CPU3) and USB1 xHCI modem (CPU2) IRQs after startup services
(
    sleep 5
    for pair in "eth0:8" "xhci-hcd:usb1:4"; do
        dev="${pair%:*}"; mask="${pair##*:}"
        irq=$(awk -v d="$dev" '$NF==d {gsub(/:/,"",$1); print $1; exit}' /proc/interrupts)
        [ -n "$irq" ] && [ -w "/proc/irq/$irq/smp_affinity" ] && echo "$mask" > "/proc/irq/$irq/smp_affinity"
    done
    ncpu=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
    if [ -n "$ncpu" ] && [ "$ncpu" -gt 1 ] 2>/dev/null; then
        xps_mask=$(printf '%x' "$(( (1 << ncpu) - 1 ))")
        for q in /sys/class/net/eth0/queues/tx-*/xps_cpus; do
            [ -w "$q" ] && echo "$xps_mask" > "$q" 2>/dev/null || true
        done
    fi
) &
tc qdisc replace dev eth0 root fq_codel 2>/dev/null || true
exit 0
