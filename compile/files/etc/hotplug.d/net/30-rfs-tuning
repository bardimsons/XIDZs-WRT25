#!/bin/sh
# RPS/RFS/XPS hotplug tuning for Amlogic S905X (HG680P)
[ "$ACTION" = "add" ] || return 0
[ -n "$INTERFACE" ] || return 0

case "$INTERFACE" in
    lo|br-*|tun*|utun*|tap*|veth*|docker*|nikki*|mihomo*) return 0 ;;
esac

[ -d "/sys/class/net/$INTERFACE/queues" ] || return 0

# Reduce cellular upload bufferbloat and USB MBIM TX aggregation delay on USB/WWAN modems
case "$INTERFACE" in
    wwan*|usb*|qmimux*)
        ip link set dev "$INTERFACE" txqueuelen 150 2>/dev/null || true
        [ -w "/sys/class/net/$INTERFACE/cdc_ncm/tx_timer_usecs" ] && echo 100 > "/sys/class/net/$INTERFACE/cdc_ncm/tx_timer_usecs" 2>/dev/null || true
        [ -w "/sys/class/net/$INTERFACE/cdc_ncm/min_tx_pkt" ] && echo 2048 > "/sys/class/net/$INTERFACE/cdc_ncm/min_tx_pkt" 2>/dev/null || true
        ;;
esac

ncpu=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
[ -n "$ncpu" ] && [ "$ncpu" -gt 1 ] 2>/dev/null || return 0

mask=$(awk -v n="$ncpu" 'BEGIN { printf "%x", (2^n) - 1 }')
[ -n "$mask" ] || return 0

for q in /sys/class/net/"$INTERFACE"/queues/rx-*; do
    [ -d "$q" ] || continue
    if [ -w "$q/rps_cpus" ]; then
        cur=$(cat "$q/rps_cpus" 2>/dev/null)
        case "$cur" in ""|0|00) echo "$mask" > "$q/rps_cpus" 2>/dev/null ;; esac
    fi
    if [ -w "$q/rps_flow_cnt" ]; then
        echo 4096 > "$q/rps_flow_cnt" 2>/dev/null
    fi
done

for q in /sys/class/net/"$INTERFACE"/queues/tx-*; do
    [ -d "$q" ] || continue
    if [ -w "$q/xps_cpus" ]; then
        cur=$(cat "$q/xps_cpus" 2>/dev/null)
        case "$cur" in ""|0|00) echo "$mask" > "$q/xps_cpus" 2>/dev/null ;; esac
    fi
done
