#!/bin/sh
# Created by Frizkyiman
# Github https://github.com/frizkyiman/

_echo() {
  [ "$1" = 'err' ] && echo "$2" >&2 || echo "$2"
  logger -p "$1" -t repair_ro "$2"
}

if [ -n "$1" ]; then
    root_device="$1"
    if ! blkid | grep -q "$root_device:"; then
        _echo err "Root file system device '$root_device' not found in the system. Unable to repair."
        exit 1
    fi
else
    root_device=$(awk '$2 == "/" && $1 ~ "^/dev/" && $1 != "/dev/root" {print $1; exit}' /proc/mounts)
    [ -z "$root_device" ] && root_device=$(blkid -L rootfs -o device 2>/dev/null)
fi

if [ -z "$root_device" ]; then
    _echo err "Root file system device not found in the system. Unable to repair."
    exit 1
fi

root_fstype=$(awk '$2 == "/" {print $3; exit}' /proc/mounts)
ro_status=$(awk '$2 == "/" && $4 ~ /(^|,)ro(,|$)/ {print "ro"; exit}' /proc/mounts)

if [ "$ro_status" = "ro" ]; then
    _echo notice "Detected root file system: $root_device ($root_fstype)"
    _echo notice "The file system is currently read-only. Initiating repair..."

    case "$root_fstype" in
        ext2|ext3|ext4)
            if e2fsck -y "$root_device"; then
                _echo notice "File system repair successful."
                _echo notice "Mounting $root_device to read-write"
                mount -o remount,rw "$root_device" /
            else
                _echo notice "An error occurred while repairing the file system."
            fi
            ;;
        btrfs)
            _echo notice "Btrfs root mounted read-only; attempting read-write remount..."
            if mount -o remount,rw "$root_device" / || mount -o remount,rw /; then
                _echo notice "Btrfs root remounted read-write."
            else
                _echo err "Failed to remount btrfs root read-write."
            fi
            ;;
        *)
            _echo err "Unsupported root filesystem '$root_fstype' on $root_device for automatic repair."
            exit 1
            ;;
    esac

    _echo notice "Rebooting the system..."
    reboot || _echo err "Reboot command failed. Please try force reboot if necessary using reboot -f"
else
    _echo notice "Root file system device '$root_device' ($root_fstype) is currently in read-write mode."
fi
